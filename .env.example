# ==========================================
# InfluxDB Measurement Backup Configuration
# ==========================================

# -- Connection Details --
# Hostname or IP of the InfluxDB server
INFLUXDB_HOST="localhost"

# Port of the InfluxDB server
INFLUXDB_PORT="8086"

# Authentication credentials (leave blank if disabled)
INFLUXDB_USER=""
INFLUXDB_PASSWORD=""


# -- Database & Measurement Setup --
# The source database where the original data lives
INFLUXDB_DATABASE="my_db"

# The destination database where the backup should go.
# Leave blank or set to the same as INFLUXDB_DATABASE to copy within the same db.
# Note: This database must already exist in InfluxDB!
TARGET_DATABASE="my_db_test"

# The original measurement name to copy from
SOURCE_MEASUREMENT="measured_v3"

# The new measurement name to copy to
TARGET_MEASUREMENT="measured_v3_backup"


# -- Time Range & Chunking --
# The beginning of the time range to copy, in ISO 8601 format
START_TIME="2023-01-01T00:00:00Z"

# The end of the time range to copy, in ISO 8601 format
END_TIME="2023-02-01T00:00:00Z"

# How many minutes of data to copy per database query.
# Lower this value if you encounter timeouts or memory issues.
CHUNK_INTERVAL_MINUTES="1"
