# ==========================================
# InfluxDB Measurement Backup Configuration
# ==========================================

TAGLIST_FILE="Taglist_2603.csv"

# -- Connection Details --
SOURCE_INFLUXDB_HOST="elab-cmv2.server.elab2.edu"
TARGET_INFLUXDB_HOST="elab-cmvc0erver.elab2.edu"

# Port of the InfluxDB server
SOURCE_INFLUXDB_PORT="586"
TARGET_INFLUXDB_PORT="50086"

# Authentication credentials (leave blank if disabled)
SOURCE_INFLUXDB_TOKEN=""
TARGET_INFLUXDB_TOKEN=""


#SOURCE_DATABASE="ernergylab"
SOURCE_DATABASE="testing"
TARGET_DATABASE="testing"


SOURCE_MEASUREMENT="cmvc_measured_v3"
TARGET_MEASUREMENT="cmvc_measured_v4"   # The new measurement name to copy to


# -- Time Range & Chunking --
# The beginning of the time range to copy, in ISO 8601 format
START_TIME="2026-05-09T00:00:00Z"

# The end of the time range to copy, in ISO 8601 format
END_TIME="2026-05-11T00:00:00Z"

# How many minutes of data to copy per database query.
# Lower this value if you encounter timeouts or memory issues.
CHUNK_INTERVAL_MINUTES="1"

# The number of concurrent chunk queries to send to InfluxDB simultaneously.
# Increase this to speed up the backup significantly, but do not set it too high
# to avoid overwhelming the database server.
MAX_CONCURRENT_QUERIES="4"

# The maximum number of chunks to process in a single run before automatically pausing.
# Leave blank to run continuously until END_TIME is reached.
MAX_CHUNKS_PER_RUN=""
